{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.rodvan/viralhunt-mcp",
  "description": "Find trending content and schedule posts across social networks via the ViralHunt.io API.",
  "repository": {
    "url": "https://github.com/viralhunt-io/viralhunt-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "viralhunt-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VIRALHUNT_API_KEY",
          "description": "Your ViralHunt personal token (vhk_...) from viralhunt.io Account > API Access.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "VIRALHUNT_BASE_URL",
          "description": "Override the API base URL (advanced).",
          "isRequired": false,
          "default": "https://viralhunt.io/tool/api/v1"
        }
      ]
    }
  ]
}
